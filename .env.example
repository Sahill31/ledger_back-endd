# --- Runtime ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
# Runtime connection string (use the pooled connection on Supabase).
DATABASE_URL=postgresql://postgres:password@localhost:5432/autoledger
# Direct (unpooled) connection used by Prisma migrations on Supabase.
# For a plain local Postgres this may be identical to DATABASE_URL.
DIRECT_URL=postgresql://postgres:password@localhost:5432/autoledger

# --- Authentication ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Document storage ---
# STORAGE_PROVIDER: "local" (dev) or "supabase" (production)
STORAGE_PROVIDER=local
# Local provider: absolute or relative directory for private bill documents.
LOCAL_STORAGE_DIR=storage
# Public base URL of this API, used when generating local signed file URLs.
PUBLIC_API_BASE_URL=http://localhost:5000
# Secret used to sign local storage download URLs (falls back to JWT_ACCESS_SECRET).
FILE_URL_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private-bills

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10

# --- Bill scanning / extraction ---
# OCR engine for image uploads: "tesseract" (local, no API credentials) or
# "none" to disable image OCR (scanning still works for text-based PDFs;
# image-only uploads then return a clear manual-entry error).
OCR_PROVIDER=tesseract
OCR_LANG=eng
OCR_TIMEOUT_MS=90000
# Hours an un-consumed scan stays valid for bill submission.
SCAN_RETENTION_HOURS=24
# PDFs yielding less text than this are treated as scanned images.
PDF_MIN_TEXT_CHARS=120

# --- Jobs ---
# Set to true for simple single-instance deployments. For multi-instance
# deployments leave false and trigger POST /api/v1/jobs/overdue-sweep
# with header x-job-secret from an external scheduler.
ENABLE_IN_PROCESS_JOBS=false
JOB_SECRET=change-me-job-secret
OVERDUE_SWEEP_INTERVAL_MINUTES=60

# --- Logging ---
LOG_LEVEL=info

# --- Demo seed (development only) ---
SEED_DEMO_DATA=true


